# ============================================================================
# PROFIT TRAINING CLUB — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and replace placeholders with your actual service credentials
# ============================================================================

# 1. DATABASE (PostgreSQL / Supabase / Neon / AWS RDS)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/profit_gym?schema=public"

# 2. APPLICATION RUNTIME & PORTS
PORT=5000
NODE_ENV=development
VITE_API_URL=http://localhost:5000/api
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://profitgym-ten.vercel.app

# 3. AUTHENTICATION & SECURITY
JWT_SECRET=replace_with_strong_random_secret_minimum_32_characters
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# 4. RAZORPAY PAYMENT GATEWAY (India)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# 5. NOTIFICATION & EMAIL SERVICES (Optional for Production)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=PROFIT Training Club <no-reply@profitgym.com>
ADMIN_NOTIFICATION_EMAIL=admin@profitgym.com

# 6. FACILITY DEFAULTS
VITE_APP_NAME=PROFIT Training Club
VITE_DEFAULT_GYM_LOCATION=NYC - NoHo Flagship (Sanctuary 01)
ATTENDANCE_COOLDOWN_MINUTES=120
MEMBER_CAPACITY_LIMIT=300

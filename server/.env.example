# ========================================================
# PROFIT Training Club - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit real credentials to GitHub or public repos!
# ========================================================

# Application Runtime
PORT=5000
NODE_ENV=development

# Allowed Origins for CORS (comma-separated, without trailing slashes)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://profitgym-ten.vercel.app

# MongoDB Atlas Connection URI
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/profit_club?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for Admin Authentication (generate a random 32+ character string)
JWT_SECRET=profit_gym_super_secret_jwt_key_2026_change_me_in_production
JWT_EXPIRES_IN=7d

# Email Notification Service (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=
OWNER_NOTIFICATION_EMAIL=
EMAIL_FROM=PROFIT Training Club <onboarding@resend.dev>

# WhatsApp Business Cloud API Configuration
# Get these credentials from https://developers.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OWNER_WHATSAPP_NUMBER=
